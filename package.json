{
  "name": "melynehouse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env --watch server/index.mjs",
    "start:api": "node --env-file=.env server/index.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:admin": "node --test tests/admin-*.test.mjs",
    "test:orders:postgres": "node --env-file=.env --test tests/order-postgres.test.mjs",
    "test:lifecycle:postgres": "node --env-file=.env --test tests/variant-lifecycle-postgres.test.mjs",
    "test:order-management:postgres": "node --env-file=.env --test tests/order-management-postgres.test.mjs",
    "test": "npm run test:admin && node --test tests/whatsapp-color.test.mjs tests/purchase.test.mjs tests/owner-products-ui.test.mjs tests/orders-dashboard-ui.test.mjs && npm run test:sites",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "local:env": "node scripts/setup-local-env.mjs",
    "db:local:setup": "node --env-file=.env scripts/setup-local-postgres.mjs",
    "db:verify": "node --env-file=.env scripts/verify-local-postgres.mjs",
    "db:acceptance:mutate": "node --env-file=.env scripts/validate-real-postgres-workflow.mjs mutate",
    "db:acceptance:verify": "node --env-file=.env scripts/validate-real-postgres-workflow.mjs verify",
    "db:migrate": "node --env-file=.env server/scripts/migrate.mjs",
    "db:import-catalog": "node --env-file=.env server/scripts/import-catalog.mjs",
    "admin:create": "node --env-file=.env server/scripts/create-admin.mjs",
    "uploads:backup": "node --env-file=.env server/scripts/backup-uploads.mjs",
    "db:backup": "node --env-file=.env server/scripts/backup-database.mjs",
    "orders:sync-sheets": "node --env-file=.env server/scripts/sync-orders-to-sheets.mjs",
    "qa:preview": "node scripts/qa-admin-preview.mjs",
    "check": "npm run validate:catalog && npm run test && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitejs/plugin-react": "5.0.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanitize-html": "^2.18.1",
    "vite": "6.4.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.4"
  }
}
