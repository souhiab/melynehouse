# Server-side only. Never expose these through VITE_* variables.
DATABASE_URL=postgresql://melyne_app:change-me@127.0.0.1:5432/melyne
MELYNE_ADMIN_EMAIL=owner@example.com
MELYNE_ADMIN_PASSWORD=replace-with-a-long-unique-password
MELYNE_SESSION_SECRET=replace-with-at-least-32-random-characters
MELYNE_UPLOAD_ROOT=D:/melyne-data/uploads
MELYNE_UPLOAD_BACKUP_ROOT=D:/melyne-data/backups
PUBLIC_BASE_URL=http://localhost:8788
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8788
PORT=8788
NODE_ENV=development

# Optional order-copy integration. Product/catalog management never uses Sheets.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
SHEET_SYNC_ENABLED=false
SHEET_SYNC_ALLOWED_ORIGIN=
# Local synthetic receiver only. Ignored in production.
SHEET_SYNC_ALLOW_LOOPBACK_MOCK=false

